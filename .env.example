# Database Configuration
# SQLite: sqlite:///./absent_requests.db
# PostgreSQL: postgresql://user:password@localhost:5432/database_name
database_url=sqlite:///./absent_requests.db

# Cookie Configuration
access_token_expire_minutes=60
access_token_cookie_key=access_token

# Auth Configuration
# Generate a secure JWT secret key using: python -c "import secrets; print(secrets.token_hex(32))"
jwt_secret_key=your_jwt_secret_key_here

# Google Configuration
google_credentials_path=credentials.json

# Pub/Sub Configuration
pubsub_oidc_topic=projects/your-project/topics/your-topic

# Email Configuration
manager_email=manager@example.com
sender_email=sender@example.com

# Email Template Configuration
email_template_file=templates/absent_request.html